PORT=4000
CORS_ORIGIN=http://localhost:5173

# Meta Llama via any OpenAI-compatible endpoint (Llama API, Together, Groq, Fireworks, OpenRouter, vLLM, Ollama...)
LLAMA_API_BASE_URL=https://api.llama.com/compat/v1
LLAMA_API_KEY=
LLAMA_MODEL=Llama-4-Maverick-17B-128E-Instruct-FP8

# Set to "true" to run without a key (canned replies) for UI demos
MOCK_LLM=false

JWT_SECRET=change-me-to-a-long-random-string
DB_PATH=./data/clerkifydx.db

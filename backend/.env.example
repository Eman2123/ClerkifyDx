PORT=4000
CORS_ORIGIN=http://localhost:5173

# Meta Model API (Muse Spark) - get a key at https://dev.meta.ai (API keys tab). Never commit it.
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_API_KEY=
# muse-spark-1.3 = Standard mode (no training on your data). Avoid the "-contributor" IDs for patient data.
MODEL_NAME=muse-spark-1.3
# Optional: minimal | low | medium | high | xhigh | max
MODEL_REASONING_EFFORT=

# Set to "true" to run without a key (canned replies) for UI demos
MOCK_LLM=false

JWT_SECRET=change-me-to-a-long-random-string
# Neon Postgres connection string (Neon dashboard > Connect). Use the pooled host (-pooler) and keep ?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Optional: creates the first admin account on startup
ADMIN_EMAIL=
ADMIN_PASSWORD=
